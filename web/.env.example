# Copy to .env.local for local development. No secrets belong here: NEXT_PUBLIC_* values end up in the browser bundle.

# Where the Gradio backend lives: a Hugging Face Space id or a URL (for a local backend).
NEXT_PUBLIC_SPACE_ID=LSAPilot/medical-app-regulatory-helper
# NEXT_PUBLIC_SPACE_ID=http://127.0.0.1:7860

# "live" (default) talks to the Space, "mock" returns canned replies without any network or API cost.
NEXT_PUBLIC_API_MODE=mock
