/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://lsapilot-medical-app-regulatory-helper.hf.space https://huggingface.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Hashed file names: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
